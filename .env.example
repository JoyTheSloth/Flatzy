# Google Sheet Web App Deployment URL (Paste your Google Apps Script URL here)
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Official Flatzy Kolkata WhatsApp Contact Number (without +, e.g. 919830000000)
VITE_WHATSAPP_NUMBER=918910376054

# Cloudinary Image Hosting (Free 25GB/mo - Get your Cloud Name & Unsigned Preset at cloudinary.com)
# 1. Sign up free at https://cloudinary.com
# 2. Go to Settings > Upload > Add upload preset > Signing Mode: 'Unsigned' > Name: 'flatzy_uploads'
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=flatzy_uploads
